API_ID=1111111 // укажите свой API_ID с https://my.telegram.org/apps
API_HASH=11111 // укажите свой API_HASH с https://my.telegram.org/apps
PHONE=+77777777777 // укажите свой номер телефона в международном формате
TG_PASSWORD=11111 // укажите свой пароль двухфакторной аутентификации, если он установлен, иначе оставьте пустым

NUMBER_RECENT_MESSAGES=100 // укажите количество последних сообщений, которые нужно получить из чата

OPEN_ROUTER_KEY=sk-or-v1-1111 // укажите свой ключ OpenRouter, который можно получить на https://openrouter.ai/
OPEN_ROUTER_MODEL=deepseek/deepseek-v4.1-flash // укажите модель OpenRouter, которую вы хотите использовать. Например, deepseek/deepseek-v4.1-flash или другую доступную модель.